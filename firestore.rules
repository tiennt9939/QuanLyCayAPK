// ROLL CAY CANH V26.0.1
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validShipmentTracking(t) {
      return t is string
        && t.size() >= 5
        && t.size() <= 80;
    }

    function shipmentTrackingClaims() {
      return request.resource.data.shipmentTracking is string
        && validShipmentTracking(
          request.resource.data.shipmentTracking
        );
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower()
          == 'tiennt9939@gmail.com';
    }

    function myProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/users/$(request.auth.uid)
          )
          && myProfile().data.role == 'admin'
          && myProfile().data.active != false
        );
    }

    function isActiveUser() {
      return signedIn()
        && (
          isBootstrapAdmin()
          || (
            exists(
              /databases/$(database)/documents/users/$(request.auth.uid)
            )
            && myProfile().data.active != false
          )
        );
    }

    function role() {
      return isBootstrapAdmin()
        ? 'admin'
        : myProfile().data.role;
    }

    function isProcurement() {
      return isActiveUser()
        && role() in [
          'procurement',
          'purchaser',
          'purchasing',
          'purchasing_staff',
          'procurement_staff',
          'thu_mua',
          'nhan_vien_thu_mua'
        ];
    }

    function canWriteData() {
      return isActiveUser()
        && role() in [
          'admin',
          'manager',
          'packer',
          'warehouse'
        ];
    }

    function isPackerUid(uid) {
      return exists(
        /databases/$(database)/documents/users/$(uid)
      )
      && get(
        /databases/$(database)/documents/users/$(uid)
      ).data.role == 'packer'
      && get(
        /databases/$(database)/documents/users/$(uid)
      ).data.active != false;
    }

    match /users/{uid} {

      allow create: if (
        isAdmin()
        && request.resource.data.role in [
          'admin',
          'manager',
          'packer',
          'warehouse',
          'procurement',
          'purchaser',
          'purchasing',
          'purchasing_staff',
          'procurement_staff',
          'thu_mua',
          'nhan_vien_thu_mua',
          'viewer'
        ]
        && (
          request.resource.data.role != 'admin'
          || (
            !('employeeId' in request.resource.data)
            && !('employeeName' in request.resource.data)
          )
        )
        && (
          request.resource.data.role !in [
            'packer',
            'procurement',
            'purchaser',
            'purchasing',
            'purchasing_staff',
            'procurement_staff',
            'thu_mua',
            'nhan_vien_thu_mua'
          ]
          || (
            request.resource.data.employeeId is string
            && request.resource.data.employeeName is string
          )
        )
      )
      || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'viewer'
      );

      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
        );

      allow update: if isAdmin()
        && (
          request.resource.data.role != 'admin'
          || (
            !('employeeId' in request.resource.data)
            && !('employeeName' in request.resource.data)
          )
        );

      allow delete: if isAdmin();
    }

    match /users/{uid}/apps/{appId} {
      allow read, write: if isAdmin()
        && request.auth.uid == uid;
    }

    match /apps/{appId} {

      allow read: if isActiveUser()
        && (
          role() in [
            'admin',
            'manager',
            'warehouse',
            'viewer'
          ]
          || isProcurement()
        );

      allow create, update: if isActiveUser()
        && (
          role() in [
            'admin',
            'manager',
            'warehouse'
          ]
          || isProcurement()
          || isBootstrapAdmin()
        );

      allow delete: if isAdmin();
    }

    match /config/{configId} {

      allow read: if isActiveUser();

      allow create, update:
        if isAdmin() || isProcurement();

      allow delete:
        if isAdmin() || isProcurement();

      match /plants/{plantId} {

        allow read: if isActiveUser();

        allow create, update:
          if isAdmin() || isProcurement();

        allow delete:
          if isAdmin() || isProcurement();
      }
    }

    match /packingOrders/{orderId} {

      allow read: if isAdmin()
        || (
          isActiveUser()
          && role() == 'packer'
          && resource.data.assignedUid == request.auth.uid
        );

      allow create: if isAdmin()
        && request.resource.data.assignedUid is string
        && isPackerUid(
          request.resource.data.assignedUid
        )
        && request.resource.data.employee is string
        && request.resource.data.plantName is string
        && request.resource.data.size is string
        && request.resource.data.packSize is number
        && request.resource.data.packSize >= 1
        && request.resource.data.packSize <= 100
        && request.resource.data.status == 'pending'
        && (
          !('shipmentTracking' in request.resource.data)
          || request.resource.data.shipmentTracking == null
          || validShipmentTracking(
            request.resource.data.shipmentTracking
          )
        );

      allow update: if isAdmin()
        || (
          isActiveUser()
          && role() == 'packer'
          && resource.data.assignedUid == request.auth.uid
          && resource.data.status == 'pending'

          && request.resource.data.assignedUid
            == resource.data.assignedUid

          && request.resource.data.employee
            == resource.data.employee

          && request.resource.data.plantIndex
            == resource.data.plantIndex

          && request.resource.data.plantName
            == resource.data.plantName

          && request.resource.data.size
            == resource.data.size

          && request.resource.data.packSize
            == resource.data.packSize

          && request.resource.data.status
            == 'completed'

          && request.resource.data.completionImage
            is string

          && request.resource.data.completionImage.size()
            > 0

          && request.resource.data.completionImages
            is list

          && request.resource.data.completionImages.size() == 2

          && request.resource.data.completionImages[0]
            is string

          && request.resource.data.completionImages[1]
            is string

          && request.resource.data.completionImages[0].size()
            > 0

          && request.resource.data.completionImages[1].size()
            > 0

          && request.resource.data.completedBy
            == request.auth.uid

          && request.resource.data.completedAt
            == request.time

          && (
            !('shipmentTracking' in request.resource.data)
            || request.resource.data.shipmentTracking == null
            || validShipmentTracking(
              request.resource.data.shipmentTracking
            )
          )
        );

      allow delete: if isAdmin();
    }

    match /assignments/{assignmentId} {

      allow read: if isAdmin()
        || (
          isActiveUser()
          && role() == 'packer'
          && resource.data.assignedUid == request.auth.uid
        );

      allow create: if isAdmin()
        && request.resource.data.assignedUid is string
        && isPackerUid(
          request.resource.data.assignedUid
        )
        && request.resource.data.createdBy
          == request.auth.uid;

      allow update: if isAdmin()
        || (
          isActiveUser()
          && role() == 'packer'
          && resource.data.assignedUid == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    match /inventory/{docId} {

      allow read, create, update, delete:
        if isAdmin();
    }

    match /inventoryLogs/{docId} {

      allow read, create, update, delete:
        if isAdmin();
    }

    match /payroll/{docId} {

      allow read: if isAdmin()
        || (
          isActiveUser()
          && role() == 'packer'
          && resource.data.employeeUid
            == request.auth.uid
        );

      allow create, update, delete:
        if isAdmin();
    }

    match /salaryAdvances/{docId} {

      allow read: if isAdmin()
        || (
          isActiveUser()
          && role() == 'packer'
          && resource.data.employeeUid
            == request.auth.uid
        );

      allow create, update, delete:
        if isAdmin();
    }

    match /reports/{docId} {

      allow read: if isAdmin()
        || (
          isActiveUser()
          && role() == 'packer'
          && resource.data.employeeUid
            == request.auth.uid
        );

      allow create, update, delete:
        if isAdmin();
    }

    match /quotes/{docId} {

      allow read, write:
        if isAdmin() || isProcurement();
    }

    match /quotation/{docId} {

      allow read, write:
        if isAdmin() || isProcurement();
    }

    match /shipmentTracking/{docId} {

      allow read: if isAdmin();

      allow create: if isAdmin()
        && shipmentTrackingClaims();

      allow update: if isAdmin()
        && (
          !('shipmentTracking' in request.resource.data)
          || request.resource.data.shipmentTracking == null
          || validShipmentTracking(
            request.resource.data.shipmentTracking
          )
        );

      allow delete: if isAdmin();
    }

    match /shipmentTrackingClaims/{trackingId} {

      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.shipmentTracking is string
        && validShipmentTracking(
          request.resource.data.shipmentTracking
        );

      allow update: if isAdmin()
        && request.resource.data.shipmentTracking is string
        && validShipmentTracking(
          request.resource.data.shipmentTracking
        );

      allow delete: if isAdmin();
    }

    match /shipmentOcr/{docId} {

      allow read: if isAdmin();

      allow create, update:
        if isAdmin();

      allow delete: if isAdmin();
    }

    match /auditLogs/{docId} {

      allow read: if isAdmin();

      allow create: if signedIn();

      allow update, delete:
        if isAdmin();
    }

    match /syncState/{docId} {

      allow read: if signedIn();

      allow create, update, delete:
        if isAdmin();
    }

    match /appState/{docId} {

      allow read: if signedIn();

      allow create, update, delete:
        if isAdmin();
    }

    match /payrollSettings/{docId} {

      allow read: if signedIn();

      allow create, update, delete:
        if isAdmin();
    }

    match /salarySettings/{docId} {

      allow read: if signedIn();

      allow create, update, delete:
        if isAdmin();
    }

    match /priceSettings/{docId} {

      allow read: if signedIn();

      allow create, update, delete:
        if isAdmin();
    }

    match /categories/{docId} {

      allow read: if signedIn();

      allow create, update, delete:
        if isAdmin() || isProcurement();
    }

    match /plantCategories/{docId} {

      allow read: if signedIn();

      allow create, update, delete:
        if isAdmin() || isProcurement();
    }

    match /sizes/{docId} {

      allow read: if signedIn();

      allow create, update, delete:
        if isAdmin() || isProcurement();
    }

    match /employees/{docId} {

      allow read: if signedIn();

      allow create, update, delete:
        if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
